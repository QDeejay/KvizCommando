<header class="app-header">
    <div class="app-header__right dropdown">
        <button id="userToggle"
                type="button"
                class="dropdown-toggle"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="User menu">
            
            
            <i class="bi bi-person-circle"></i>
            <span class="ms-2"></span>
        </button>

        <ul id="userMenu" class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header">@DisplayName</h6></li>
            <li>
                <button type="button" class="dropdown-item" @onclick="HandleProfileAsync">
                    <span>@lclRow1 - F3</span>
                </button>
            </li>
            <li>
                <button type="button" class="dropdown-item" @onclick="HandleSettingsAsync">
                    <span>@lclRow2 - F2</span>
                </button>
            </li>
            <li><button type="button" class="dropdown-item" @onclick="HandleHelpAsync">@lclRow3</button></li>
            <li><hr class="dropdown-divider" /></li>
            <li><button  class="dropdown-item" @onclick="HandleLogoutAsync">@lclLogout</button></li>
        </ul>
    </div>
</header>
