@page "/solo-game"

@using KvizCommando.Client.Features.Solo.Components

@inherits Utilities.KcComponentBase

<PageContainer>
    @if (_isReady)
    {
        <div class="@SelectorCss">
            @foreach (var bx in _boxOrder)
            {
                var box = Box(bx);

                <ContentBox Vm="@box"
                            OnClick="OnBoxClick">
                    <ContentBody>
                        @if (box.BodyComponent is not null)
                        {
                            <DynamicComponent Type="@box.BodyComponent"
                                              Parameters="@box.BodyParameters" />
                        }
                    </ContentBody>
                </ContentBox>
            }
        </div>
    }
</PageContainer>
