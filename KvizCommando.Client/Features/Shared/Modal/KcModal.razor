<div class="modal fade" id="@Id" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered @ModalSizeClass">
        <div class="modal-content modal-custom kc-window-shell">

            <div class="modal-header-custom kc-window-header text-center">
                <h5 class="modal-title-custom kc-window-title">@Lang[Par.TitleKey]</h5>
                <button type="button" class="modal-close kc-window-close"
                        @onclick="CloseAsync"
                        aria-label="@Lang["modal.Aria.Close"]">×</button>
            </div>

            <div id="termsBody"
                 class="modal-body kc-modal-body kc-window-body"
                 style="@BodyStyle"
                 @onscroll="OnBodyScroll">
                    
                <CascadingValue Value="Appstates">
                    <CascadingValue Value="Par.Mode">
                        @if (Par.BodyComponent != null)
                        {
                            <DynamicComponent Type="@Par.BodyComponent"
                                              Parameters="@Par.BodyParameters" />
                        }
                        else
                        {
                            @ChildContent
                        }
                    </CascadingValue>
                 </CascadingValue>
            </div>
               
            <div class="modal-checkbox">
                @if (!string.IsNullOrWhiteSpace(Par.CheckBoxTextKey) && Par.CheckBoxTextKey != "#")
                {
                    <input class="form-check-input custom-checkbox" type="checkbox" id="notshow" @bind="CheckBox" />
                    <label class="form-check-label notshow-label" for="notshow">
                        @Lang[Par.CheckBoxTextKey]
                    </label>
                }
            </div>

            <div class="modal-footer-custom kc-window-footer d-flex justify-content-around">
                @if (!string.IsNullOrWhiteSpace(Par.ActionTextKey1) && Par.ActionTextKey1 != "#")
                {
                    <button class="military-button"
                            disabled="@(CanAccept==false)"
                            @onclick="OnActionClicked1"
                            style="@Par.ActionStyle1">
                        @Lang[Par.ActionTextKey1]
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(Par.ActionTextKey2) && Par.ActionTextKey2 != "#")
                {
                    <button class="military-button"
                            style="@Par.ActionStyle2"
                            disabled="@(CanAccept == false)"
                            @onclick="OnActionClicked2">
                        @Lang[Par.ActionTextKey2]
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(Par.CloseTextKey) && Par.CloseTextKey != "#")
                {
                    <button class="military-button--secondary"
                            @onclick="CloseAsync">
                        @Lang[Par.CloseTextKey]
                    </button>
                }
            </div>

        </div>
    </div>
</div>
