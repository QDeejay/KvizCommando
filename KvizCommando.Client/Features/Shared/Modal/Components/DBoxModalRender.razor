@using KvizCommando.Client.Features.Shared.Modal.Builders;

<div class="modal-display">
    <div class="modal-layout">
        @switch (DialogBoxType)
        {
            case DBoxConfirmTypes.LanguageConfirm:
                @Lang[$"modal.dialog.Language.Content.{RequestedLanguage}"]
                break;
            case DBoxConfirmTypes.SoloGameQuitConfirm:
                @Lang["modal.dialog.Solo.Quit.Confirm"]
                break;
            case DBoxConfirmTypes.VsGameQuitConfirm:
                @Lang["modal.dialog.VsGame.Quit.Confirm"]
                break;
            case DBoxConfirmTypes.AccountDeletionConfirm:
                @Lang["modal.dialog.Profile.Delete.Confirm"]
                break;
            default:
                break;
        }
    </div>
</div>
