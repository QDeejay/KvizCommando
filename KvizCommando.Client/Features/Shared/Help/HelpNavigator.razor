@inherits Utilities.KcComponentBase

@if (_showHelp && _pages.Length > 0)
{
    <div class="kc-help-backdrop kc-window-backdrop">
        <section class="kc-help-window kc-window-dialog kc-window-shell @(_showNavigation ? "with-navigation" : null)"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="kc-help-title">
            <header class="kc-help-header kc-window-header">
                <div>
                    <span class="kc-help-kicker kc-window-kicker">KCV // FIELD MANUAL</span>
                    <h2 id="kc-help-title" class="kc-window-title">
                        @WindowTitle
                    </h2>
                </div>
                <button type="button"
                        class="kc-help-x kc-window-close"
                        aria-label="@CloseLabel"
                        @onclick="Close">
                    ×
                </button>
            </header>

            <div class="kc-help-main kc-window-main @(_showNavigation ? "with-navigation" : null)">
                @if (_showNavigation)
                {
                    <button type="button"
                            class="kc-help-nav-toggle"
                            aria-expanded="@_navigationOpen"
                            @onclick="ToggleNavigation">
                        <span>@NavigationLabel</span>
                        <span aria-hidden="true">@(_navigationOpen ? "▲" : "▼")</span>
                    </button>

                    <aside class="kc-help-navigation kc-window-navigation @(_navigationOpen ? "open" : null)"
                           aria-label="@NavigationLabel">
                        <div class="kc-help-navigation-title kc-window-navigation-title">@NavigationLabel</div>
                        <nav class="kc-help-tree kc-window-navigation-list">
                            @foreach (var root in NavigationRoots)
                            {
                                var seenPackages = GetSeenPackages(root).ToArray();
                                var hasSeenPackages = seenPackages.Length > 0;
                                var isExpanded = _expandedRoots.Contains(root);

                                <div class="kc-help-tree-root">
                                    <button type="button"
                                            class="kc-help-root-button kc-window-navigation-button @(isExpanded ? "expanded" : null)"
                                            disabled="@(!hasSeenPackages)"
                                            aria-expanded="@isExpanded"
                                            @onclick="() => ToggleRoot(root)">
                                        <span class="kc-help-tree-arrow kc-window-navigation-mark" aria-hidden="true">
                                            @(hasSeenPackages ? (isExpanded ? "▾" : "▸") : "—")
                                        </span>
                                        <span>@Ui.Lang[$"home.Box.Title.{root}"]</span>
                                    </button>

                                    @if (isExpanded)
                                    {
                                        <div class="kc-help-tree-children">
                                            @foreach (var package in seenPackages)
                                            {
                                                <button type="button"
                                                        class="kc-help-package-button @(package.Key == _selectedHelpKey ? "active" : null)"
                                                        aria-current="@(package.Key == _selectedHelpKey ? "page" : null)"
                                                        @onclick="() => SelectPackageAsync(package.Key)">
                                                    @Ui.Lang[package.Value.TitleKey]
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </nav>
                    </aside>
                }

                <div class="kc-help-content kc-window-body kc-themed-window-content @(_isLandingPage ? "landing" : null)"
                     style="@BackgroundStyle">
                    <div class="kc-help-content-inner">
                        @_pages[_currentPage]
                    </div>
                </div>
            </div>

            <div class="kc-help-footer kc-window-footer">
                @if (!_isLandingPage)
                {
                    <div class="kc-help-pagination" aria-label="@PageLabel">
                        @for (var i = 0; i < _pages.Length; i++)
                        {
                            var pageIndex = i;
                            <button type="button"
                                    class="kc-help-page-dot @(pageIndex == _currentPage ? "active" : null)"
                                    aria-label="@PageLabel @(pageIndex + 1)"
                                    aria-current="@(pageIndex == _currentPage ? "page" : null)"
                                    @onclick="() => GoToPage(pageIndex)">
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div></div>
                }

                <div class="kc-help-buttons">
                    @if (_currentPage > 0)
                    {
                        <button type="button"
                                class="military-button--secondary"
                                @onclick="PreviousPage">
                            <span aria-hidden="true">◀</span>
                            @PreviousLabel
                        </button>
                    }

                    @if (_currentPage < _pages.Length - 1)
                    {
                        <button type="button"
                                class="military-button--secondary"
                                @onclick="NextPage">
                            @NextLabel
                            <span aria-hidden="true">▶</span>
                        </button>
                    }
                    else if (!_isAutomatic &&
                             GetNextSeenHelpKey().HasValue)
                    {
                        <button type="button"
                                class="military-button--secondary"
                                aria-label="@NextLabel"
                                @onclick="NextPackageAsync">
                            <span aria-hidden="true">▶▶</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="military-button--secondary"
                                @onclick="Close">
                            @CloseLabel
                        </button>
                    }
                </div>
            </div>
        </section>
    </div>
}
