@inherits Utilities.KcComponentBase
@using KvizCommando.Client.Models.Settings

@if (_isOpen)
{
    <div class="kc-settings-backdrop kc-window-backdrop">
        <section class="kc-settings-window kc-window-dialog kc-window-shell"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="kc-settings-title">
            <header class="kc-settings-header kc-window-header">
                <div>
                    <span class="kc-window-kicker">KCV // CLIENT CONFIG</span>
                    <h2 id="kc-settings-title" class="kc-window-title">@Ui.Lang["mainlayout.Settings.Title"]</h2>
                </div>
                <button type="button"
                        class="kc-window-close"
                        aria-label="@Ui.Lang["mainlayout.Settings.Button.Close"]"
                        @onclick="Close">
                    ×
                </button>
            </header>

            <div class="kc-settings-main kc-window-main">
                <aside class="kc-window-navigation kc-window-navigation--sections" aria-label="@Ui.Lang["mainlayout.Settings.Navigation"]">
                    <div class="kc-window-navigation-title">@Ui.Lang["mainlayout.Settings.Navigation"]</div>
                    <nav class="kc-window-navigation-list">
                        @foreach (var section in Enum.GetValues<SettingsSection>())
                        {
                            <button type="button"
                                    class="kc-window-navigation-button @(section == _selectedSection ? "active" : null)"
                                    aria-current="@(section == _selectedSection ? "page" : null)"
                                    @onclick="() => SelectSection(section)">
                                <span class="kc-window-navigation-mark" aria-hidden="true">@(section == _selectedSection ? "▸" : "·")</span>
                                <span>@Ui.Lang[$"mainlayout.Settings.Section.{section}"]</span>
                            </button>
                        }
                    </nav>
                </aside>

                <div class="kc-settings-content kc-window-body kc-themed-window-content">
                    @switch (_selectedSection)
                    {
                        case SettingsSection.Sound:
                            <section aria-labelledby="kc-settings-sound-title">
                                <h3 id="kc-settings-sound-title">@Ui.Lang["mainlayout.Settings.Section.Sound"]</h3>

                                <label class="kc-settings-row kc-settings-toggle-row">
                                    <strong>@Ui.Lang["mainlayout.Settings.Sound.Enabled"]</strong>
                                    <span class="kc-settings-switch">
                                        <input type="checkbox"
                                               @bind="_draft.SoundEnabled"
                                               @bind:after="SaveAsync" />
                                        <span aria-hidden="true"></span>
                                    </span>
                                </label>

                                <label class="kc-settings-row kc-settings-range-row">
                                    <span>
                                        <strong>@Ui.Lang["mainlayout.Settings.Sound.MusicVolume"]</strong>
                                        <output>@_draft.MusicVolume%</output>
                                    </span>
                                    <input type="range"
                                           min="0"
                                           max="100"
                                           step="1"
                                           @bind="_draft.MusicVolume"
                                           @bind:after="SaveAsync" />
                                </label>

                                <label class="kc-settings-row kc-settings-range-row">
                                    <span>
                                        <strong>@Ui.Lang["mainlayout.Settings.Sound.SfxVolume"]</strong>
                                        <output>@_draft.SfxVolume%</output>
                                    </span>
                                    <input type="range"
                                           min="0"
                                           max="100"
                                           step="1"
                                           @bind="_draft.SfxVolume"
                                           @bind:after="SaveSfxVolumeAsync" />
                                </label>
                            </section>
                            break;

                        case SettingsSection.Appearance:
                            <section aria-labelledby="kc-settings-appearance-title">
                                <h3 id="kc-settings-appearance-title">@Ui.Lang["mainlayout.Settings.Section.Appearance"]</h3>

                                <div class="kc-settings-row">
                                    <strong>@Ui.Lang["mainlayout.Settings.Appearance.Theme"]</strong>
                                    <div class="kc-settings-themes">
                                        @foreach (var theme in Enum.GetValues<VisualTheme>())
                                        {
                                            <button type="button"
                                                    class="kc-settings-theme kc-settings-theme-@theme.ToString().ToLowerInvariant() @(theme == _draft.Theme ? "active" : null)"
                                                    aria-pressed="@(theme == _draft.Theme)"
                                                    @onclick="() => SetThemeAsync(theme)">
                                                <span class="kc-settings-theme-swatch" aria-hidden="true">
                                                    <span></span><span></span><span></span>
                                                </span>
                                                <span>@Ui.Lang[$"mainlayout.Settings.Theme.{theme}"]</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <label class="kc-settings-row kc-settings-toggle-row">
                                    <strong>@Ui.Lang["mainlayout.Settings.Appearance.Fullscreen"]</strong>
                                    <span class="kc-settings-switch">
                                        <input type="checkbox"
                                               @bind="_draft.StartFullscreen"
                                               @bind:after="SaveAsync" />
                                        <span aria-hidden="true"></span>
                                    </span>
                                </label>
                            </section>
                            break;

                        case SettingsSection.Help:
                            <section aria-labelledby="kc-settings-help-title">
                                <h3 id="kc-settings-help-title">@Ui.Lang["mainlayout.Settings.Section.Help"]</h3>

                                <div class="kc-settings-row kc-settings-help-row">
                                    <div>
                                        <strong>@Ui.Lang["mainlayout.Settings.Help.Reset.Title"]</strong>
                                        <p>@Ui.Lang["mainlayout.Settings.Help.Reset.Description"]</p>
                                    </div>
                                    <button type="button"
                                            class="military-button"
                                            @onclick="ResetHelpsAsync">
                                        @Ui.Lang["mainlayout.Settings.Help.Reset.Button"]
                                    </button>
                                    @if (_helpsReset)
                                    {
                                        <div class="kc-settings-success" role="status">
                                            @Ui.Lang["mainlayout.Settings.Help.Reset.Success"]
                                        </div>
                                    }
                                </div>
                            </section>
                            break;
                    }
                </div>
            </div>

            <footer class="kc-settings-footer kc-window-footer">
                <span class="kc-settings-autosave">@Ui.Lang["mainlayout.Settings.Autosave"]</span>
                <button type="button" class="military-button--secondary" @onclick="Close">
                    @Ui.Lang["mainlayout.Settings.Button.Close"]
                </button>
            </footer>
        </section>
    </div>
}
