@page "/forgotpsw"
@inherits Utilities.KcComponentBase
@layout LoginLayout

<LangGuard Culture=@culture Module="forgotosw">
<div class="forgotpsw-panel">
    <div class="forgotpsw-head">
            <label class="label-title">@Ui.Lang["forgotosw.Title"]</label>
    </div>
    <div class="forgotpsw-body">
            @if (Success != true)
            {
                <label class="label-text">@Ui.Lang["forgotosw.Email"] </label>
                <input class="lcd-input"
                       type="text"
                       name="kc-forgot-password-email"
                       autocomplete="off"
                       @bind-value="formData.email"
                       @bind-value:event="oninput"
                       style="@((ColorSW ? "border: 1px solid red;" : null))" />
        
        
        
                <button class="military-button" disabled="@(!CanSend)" type="button" @onclick="SendEmail">
                        @Ui.Lang["common.Button.Send"]
                </button>
                @if (!string.IsNullOrWhiteSpace(ResultMessage))
                {
                    <p class="kc-auth-field-error">@ResultMessage</p>
                }
            }
            else
            {
                <div class="kc-auth-status kc-auth-status--success">
                    <i class="bi bi-envelope-check-fill kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">@Ui.Lang["forgotosw.Success.Title"]</h2>
                        <p class="kc-auth-status__text">@ResultMessage</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(PasswordResetEmailOutputPath))
                {
                    <div class="kc-dev-email-location">
                        <div class="kc-dev-email-location__title">
                            <i class="bi bi-folder2-open"></i>
                            <span>@Ui.Lang["forgotosw.EmailOutput.Title"]</span>
                        </div>
                        <p class="kc-dev-email-location__text">
                            @Ui.Lang["forgotosw.EmailOutput.Description"]
                        </p>
                        <code class="kc-dev-email-location__path">@PasswordResetEmailOutputPath</code>
                    </div>
                }
            }
    </div>


    <div class="forgotpsw-footer">
        <button class="military-button--secondary" @onclick="NavigateHome">
                @Ui.Lang["common.Button.Back"]
        </button>

    </div>
</div> 
</LangGuard>
