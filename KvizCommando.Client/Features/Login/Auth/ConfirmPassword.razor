@page "/auth/reset-password"

@inherits Utilities.KcComponentBase
@layout LoginLayout

<LangGuard Culture=@_culture Module="auth">
    <div class="pswreset-panel">
        <div class="emailconfirm-head">
            <label class="label-title">@Ui.Lang["auth.psw.Title"]</label>
             </div>
        @if (FormData.resetCode!=null && success != true)
         {                 
                                <div class="pswreset-body">
                <label class="label-text">@Ui.Lang["auth.psw.NewPassword"]</label>
                                    <div class="password-box">
                                        <input class="lcd-input"
                                               type="@PasswordType(0)"
                                               name="kc-reset-password"
                                               autocomplete="new-password"
                                               @bind-value="FormData.newPassword"
                                               @bind-value:event="oninput"
                                               style="@((PasswordFiledSW ? "border: 1px solid red;" : null))" />
                                        @if (!string.IsNullOrEmpty(FormData.newPassword))
                                        {
                                            <button type="button"
                                                    class="password-toggle"
                                                    aria-label="@Ui.Lang["common.Password.Visibility"]"
                                                    aria-pressed="@_showPassword[0]"
                                                    @onclick="() => TogglePassword(0)">
                                                <i class="@EyeIcon(0)" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>

                <label class="label-text">@Ui.Lang["auth.psw.NewPasswordConfirm"]</label>
                                    <div class="password-box">
                                        <input class="lcd-input"
                                               type="@PasswordType(1)"
                                               name="kc-reset-password-confirm"
                                               autocomplete="new-password"
                                               @bind-value="FormData.confirmedNewPsw"
                                               @bind-value:event="oninput"
                                               style="@((PasswordFiledSW ? "border: 1px solid red;" : null))" />
                                        @if (!string.IsNullOrEmpty(FormData.confirmedNewPsw))
                                        {
                                            <button type="button"
                                                    class="password-toggle"
                                                    aria-label="@Ui.Lang["common.Password.Visibility"]"
                                                    aria-pressed="@_showPassword[1]"
                                                    @onclick="() => TogglePassword(1)">
                                                <i class="@EyeIcon(1)" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="pswresetbutton-row">
                                    <button class="military-button" disabled="@(!CanRecover)" type="button" @onclick="HandleValidSubmit">
                                        @Ui.Lang["auth.buttton.RecoverPsw"]
                                    </button>
                                    <button class="military-button--secondary" @onclick="NavigateHome">
                                        @Ui.Lang["auth.button.RedirectToLogin"]
                                    </button>
                                </div>
            @if (!string.IsNullOrWhiteSpace(ResultMessage))
            {
                <p class="kc-auth-field-error">@ResultMessage</p>
            }
        }
        else
        {
            @if (success == true)
            {
                <div class="kc-auth-status kc-auth-status--success">
                    <i class="bi bi-check-circle-fill kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">@Ui.Lang["auth.psw.Success"]</h2>
                        <p class="kc-auth-status__text">@Ui.Lang["auth.psw.Success.Description"]</p>
                    </div>
                </div>
            }
            else
            {
                <div class="kc-auth-status kc-auth-status--error">
                    <i class="bi bi-x-circle-fill kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">@Ui.Lang["auth.psw.Fail"]</h2>
                        <p class="kc-auth-status__text">@Ui.Lang["auth.psw.Fail.Description"]</p>
                    </div>
                </div>
            }
            <div class="pswreset-footer">
                <button class="military-button--secondary" @onclick="NavigateHome">
                    @Ui.Lang["auth.button.RedirectToLogin"]
                 </button>
             </div>
        }

    </div>
</LangGuard>




