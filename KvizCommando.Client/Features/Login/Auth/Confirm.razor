@page "/auth/confirm"

@inherits Utilities.KcComponentBase
@layout LoginLayout

    <div class="emailconfirm-panel">
        <div class="emailconfirm-head">
            <label class="label-title">@Lang["auth.email.Title"]</label>
        </div>
        <div class="emailconfirm-body">
            @if (_isLoading)
            {
                <div class="kc-auth-status kc-auth-status--loading">
                    <i class="bi bi-hourglass-split kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">@Lang["auth.email.Loading"]</h2>
                        <p class="kc-auth-status__text">@Lang["auth.email.Loading.Description"]</p>
                    </div>
                </div>
            }
            else if (_isSuccess == true)
            {
                <div class="kc-auth-status kc-auth-status--success">
                    <i class="bi bi-check-circle-fill kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">
                            @Lang[_isEmailChange
                                ? "auth.email.Change.Success"
                                : "auth.email.Success"]
                        </h2>
                        <p class="kc-auth-status__text">
                            @Lang[_isEmailChange
                                ? "auth.email.Change.Success.Description"
                                : "auth.email.Success.Description"]
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="kc-auth-status kc-auth-status--error">
                    <i class="bi bi-x-circle-fill kc-auth-status__icon"></i>
                    <div>
                        <h2 class="kc-auth-status__title">@Lang["auth.email.Fail"]</h2>
                        <p class="kc-auth-status__text">@Lang["auth.email.Fail.Description"]</p>
                    </div>
                </div>
            }
        </div>


        <div class="emailconfirm-footer">
            <button class="military-button--secondary" @onclick="NavigateHome">
                @Lang["auth.button.RedirectToLogin"]
            </button>

        </div>
    </div>
