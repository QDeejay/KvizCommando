@using KvizCommando.Client.Features.VsGame.Match.ViewModels
@using KvizCommando.Client.Components.CharacterComponent

<aside class="kc-vs-roster compact-columns-@CompactColumnCount compact-count-@RosterCardCount">
    <header>
        <i class="bi bi-broadcast-pin"></i>
        <strong>@Title</strong>
    </header>

    @foreach (var player in Players)
    {
        <article class="kc-vs-roster-card @PlayerToneClass(player.Position) @(player.IsMe ? "me" : "") @(!player.IsConnected && !player.IsBot ? "disconnected" : "") @(player.IsBot ? "bot" : "") @(player.IsMe && CurrentTimeModifierSeconds.HasValue ? "has-modifier" : "") @(ShowScore ? "has-score" : "")">
            <span class="kc-vs-roster-connection @ConnectionQualityClass(DisplayedConnectionQuality(player))"
                  title="@ConnectionTitle(player)">
                <i class="bi @ConnectionIconClass(player)"></i>
            </span>

            <div class="kc-vs-roster-visual">
                <div class="kc-vs-roster-avatar">
                    @if (player.ActiveCharacter is not null)
                    {
                        <div class="kc-vs-roster-svg-host">
                            <CharacterView 
                                PicCode="@player.ActiveCharacter.PictureCode" />
                     
                        </div>
                    }
                    else
                    {
                        <img src="@player.TeamPictureSrc"
                             alt="@player.TeamName" />
                    }
                </div>
            </div>

            <div class="kc-vs-roster-data">
                <strong title="@player.TeamName">@player.TeamName</strong>
                <span title="@player.DisplayName">@player.DisplayName</span>
                @if (player.ActiveCharacter is not null)
                {
                    <small class="@(player.ActiveCharacter.PictureCode[0] == 'M' ? "male" : "female")">
                        @player.ActiveCharacter.Name
                    </small>
                }
                else
                {
                    <small>@player.TeamLevel</small>
                }
            </div>

            @if (player.IsMe &&
                 CurrentTimeModifierSeconds.HasValue)
            {
                <strong class="kc-vs-roster-modifier @ModifierClass(CurrentTimeModifierSeconds.Value)">
                    @ModifierText(CurrentTimeModifierSeconds.Value)
                </strong>
            }

            @if (ShowScore)
            {
                <div class="kc-vs-roster-score">
                    <strong>@player.TotalPoints</strong>
                    <small>
                        @Seconds(player.TotalTimeSeconds)
                    </small>
                </div>
            }
            else
            {
                <span class="kc-vs-roster-state @(player.IsFinished ? "ready" : "")"></span>
            }
        </article>
    }

    @for (var index = 0; index < MissingPlayers; index++)
    {
        <article class="kc-vs-roster-card searching">
            <span class="kc-vs-roster-search-ring"></span>
        </article>
    }
</aside>

@*
    MÓDOSÍTÁS: a bal oldali roster a látványterv kompakt, állandó
    csapatkártya-sávját követi, külön fejlécet, egyértelmű saját
    játékoskiemelést és a lobbyban hiányzó helyekhez egyetlen forgó
    keresőjelzőt használ.

    MÓDOSÍTÁS: normál körben a korlátozott karakter-SVG-t, a többi
    fázisban a csapatavatart mutatja; játéknál összpontot és összidőt
    jelenít meg.
    MÓDOSÍTÁS: a saját kártya jobb felső sarkában, amikor releváns,
    az aktuális időmódosítót is megjeleníti. Aktív karakter esetén
    annak neve a PictureCode első betűje alapján férfi/női színt kap;
    a csapatszint színe változatlan.
    MÓDOSÍTÁS: a szerveroldali bot külön, halvány rosterállapotot és
    jól olvasható BOT feliratot kap; nem egyszerű kapcsolatvesztésként
    jelenik meg.
    MÓDOSÍTÁS: a játékos pozíciójához tartozó, kiértékelésnél is
    használt kék/sárga/lila/szürke tónus finom kártyaháttérként a
    rosterben is végig látható.

    A meccs teljes ideje alatt látható, kompakt ellenfél- és
    csapatkártya-sáv.
    MÓDOSÍTÁS: az egyszer mért kapcsolatminőség hasábos jelzője álló
    rosterben a bal felső sarokban, vízszintes rosterben pedig első
    elemként, függőlegesen középre rendezve jelenik meg.
    MÓDOSÍTÁS: megszakadt helyi SignalR-kapcsolatnál minden korábbi
    pingjelző azonnal szürke, ismeretlen állapotba vált.
    A megfelelő tartományon belül 0–50 ms négy, 51–100 ms három
    hasábot kap; a közepes kettő, a rossz egy hasáb marad.
    MÓDOSÍTÁS: keskeny nézetben négy rosterhely 2 × 2 elrendezést,
    három hely 2 + 1 középre rendezett elrendezést, kettő hely pedig
    egyetlen sort kap.
    MÓDOSÍTÁS: kizárólag a keskeny felső rosterben a modifier mellett
    a csapatnév, a pont/idő mellett pedig a karakternév kap tényleges
    ellipszishez szükséges helykorlátot.
*@
