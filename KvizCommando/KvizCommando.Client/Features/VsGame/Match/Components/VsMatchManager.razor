@using KvizCommando.Shared.Models.Enums.VsGame

<div class="kc-vs-match-manager">
    @if (_match is not null)
    {
        <div class="kc-vs-match-stage">
            <VsMatchRoster
                Players="@_match.Players"
                Title="@Lang["vsgame.Match.Roster.Match"]" />

            <main class="kc-vs-match-content">
                @if (_match.Phase == VsMatchPhase.MatchLocked)
                {
                    <div class="kc-vs-match-locked">
                        <i class="bi bi-shield-lock-fill"></i>
                        <strong>@_match.InfoText</strong>
                        <span>@Lang["vsgame.Match.Info.LoadingQuestions"]</span>
                    </div>
                }
                else
                {
                    <VsMatchPreparationView
                        Data="@_match"
                        OnCharacterSelected="SelectCharacterAsync"
                        OnLoadoutAssigned="AssignLoadoutAsync"
                        OnHelpAssigned="AssignHelpAsync"
                        OnReset="ResetPreparationAsync"
                        OnFinish="FinishPreparationAsync" />
                }
            </main>
        </div>
    }
    else if (_queue is not null)
    {
        <div class="kc-vs-match-stage">
            <VsMatchRoster
                Players="@_queue.Players"
                ExpectedPlayers="@_queue.RequiredPlayers"
                Title="@Lang["vsgame.Match.Roster.Lobby"]" />

            <main class="kc-vs-match-content">
                <section class="kc-vs-queue">
                    <h3>@_queue.ClassificationText</h3>
                    <p>@_queue.StatusText</p>

                    <div class="kc-vs-queue-counter">
                        <span>@_queue.WaitingPlayers</span>
                        <small>/ @_queue.RequiredPlayers</small>
                    </div>

                    <div class="kc-vs-queue-conditions">
                        <span>
                            <i class="bi bi-diagram-3-fill"></i>
                            <strong>@_queue.RequiredPartySize</strong>
                            + 1
                        </span>
                        <span>
                            @Lang["vsgame.Match.Queue.Stake"]
                            <strong>@_queue.Stake</strong>
                        </span>
                    </div>
                </section>
            </main>
        </div>
    }
    else
    {
        <section class="kc-vs-queue connecting">
            <div class="kc-vs-queue-emblem">
                <i class="bi bi-broadcast"></i>
            </div>
            <h3>@Lang["vsgame.Match.Status.Connecting"]</h3>
        </section>
    }
</div>

@*
    A VS menü DynamicComponentként példányosított ranked meccsmanagere.
    MÓDOSÍTÁS: a lobby is a látványterv kétoszlopos stage-ét használja:
    bal oldalt a várakozók és hiányzó helyek, jobb oldalt a kör alakú
    számláló és az alapfeltételek látszanak. A meccs- és lobby-roster
    címe közvetlen szöveg helyett a vsgame lokalizációból érkezik.
    A hibaüzenetet callbacken adja át a VsGame lapnak, hogy az ne a
    ContentBox levágott rétegében jelenjen meg.

    A várólistát, a MatchLocked betöltést, a rostert és az aktuális
    preparációs nézetet a SignalR snapshot alapján cseréli.
*@
