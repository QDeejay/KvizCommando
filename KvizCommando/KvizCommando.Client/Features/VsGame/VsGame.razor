@page "/vs-game"

@inherits Utilities.KcComponentBase

<LangGuard Culture="@Culture"
           Module="vsgame"
           OnReady="BuildBoxes">
    @if (!string.IsNullOrWhiteSpace(_matchErrorText))
    {
        <div class="kc-vsgame-match-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_matchErrorText</span>
        </div>
    }

    <PageContainer>
        @if (_isReady)
        {
            <div class="kc-vsgame-selector">
                @foreach (var key in _boxOrder)
                {
                    var box = Box(key);

                    <ContentBox Vm="@box"
                                OnClick="OnBoxClick">
                        <ContentBody>
                            @if (box.BodyComponent is not null)
                            {
                                <DynamicComponent
                                    Type="@box.BodyComponent"
                                    Parameters="@box.BodyParameters" />
                            }
                        </ContentBody>
                    </ContentBox>
                }
            </div>
        }
    </PageContainer>
</LangGuard>

@*
    MÓDOSÍTÁS: a ranked meccs piros hibasávja a ContentBox testvér-
    rétegében jelenik meg, ezért annak opacity/overflow rétege nem
    takarhatja el.
*@
