@using KvizCommando.Client.Helpers


        <div class="list-grid">
            <div></div>
            <div class="list-header no-cell">@Lang["question.Table.Header.No"]</div>
            <div class="list-header category-cell">@Lang["question.Table.Header.Category"]</div>

            @for (var i = 0; i < _workingCodes.Length; i++)
            {
                var row = i;

                if (CanSelectOwnQuestion(row))
                {
                    _options = CatHelper.OptionsUpdate(CategoryOptionHelpers.optionType.Own, ExtInfo.CharCatMask);
                    <div><i class="bi bi-person-raised-hand"></i></div>
                }
                else
                {
                    _options = CatHelper.OptionsUpdate(CategoryOptionHelpers.optionType.Normal, ExtInfo.CharCatMask);
                    <div></div>
                }

                <div class="no-cell">@((row + 1).ToString())</div>

                <div class="value-cell @(_editingRowIndex == row ? "editing" : null)">
                    @if (_editingRowIndex == row)
                    {
                        <select class="inline-editor"
                                @bind="_workingCodes[row]"
                                @bind:event="onchange"
                                @onclick:stopPropagation="true"
                                @onkeydown="OnEditorKeyDown"
                                autofocus>
                            @foreach (var opt in _options)
                            {
                                <option value="@opt.Code">@QuestionHelper.GetLabel(opt, Culture)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <button type="button"
                                class="value-button"
                                @onclick="() => StartEdit(row)"
                                @onclick:stopPropagation="true">
                                @CatHelper.ResolveLabel(_workingCodes[row], Culture)
                        </button>
                    }
                </div>
            }
        </div>
        <br>
        <div class="component-button-row">
            <div class="component-button-group right">
            <button class="button-on-lcd" @onclick="OnSaveSlotsAsync" disabled="@(!IsDirty)">
                        <i class="bi bi-floppy"></i>
                    </button>
            </div>
        </div>




@*
    MÓDOSÍTÁS: a fix tíz sor helyett a szervertől kapott loadoutméretet
    jeleníti meg. A saját kérdésre alkalmas helyet személy-kérdés ikon
    jelöli; az optionlista meglévő Normal/Own felépítése változatlan.
*@
