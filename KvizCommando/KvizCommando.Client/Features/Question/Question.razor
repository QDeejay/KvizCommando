@page "/question"

@inherits Utilities.KcComponentBase

<link href="css/question-common.css" rel="stylesheet" />

<LangGuard Culture="@Culture" Module="question" OnReady="SetReady">
    <PageContainer>
        @if (_isReady)
        {
            var boxes = BuildBoxes();

            <div class="kc-quest-selector">
                @foreach (var boxKey in _boxOrder)
                {
                    var box = boxes[boxKey];

                    <ContentBox Vm="@box"
                                OnClick="OnBoxClick">
                        <ContentBody>
                            <DynamicComponent Type="@box.BodyComponent" />
                        </ContentBody>
                    </ContentBox>
                }
            </div>
        }
    </PageContainer>
</LangGuard>
