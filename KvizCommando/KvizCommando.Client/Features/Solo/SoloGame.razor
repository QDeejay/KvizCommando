@page "/solo-game"

@using KvizCommando.Client.Features.Solo.Components

@inherits Utilities.KcComponentBase

<LangGuard Culture="@Culture" Module="solo" OnReady="BuildBoxes">
    <PageContainer>
        @if (_isReady)
        {
            <div class="@SelectorCss">
                @foreach (var bx in _boxOrder)
                {
                    var box = Box(bx);

                    <ContentBox Vm="@box"
                                OnClick="OnBoxClick">
                        <ContentBody>

                                <SoloGameManager Mode="@_gameMode"
                                                 SelectionId="@_selectionId"
                                                 Title="@_gameTitle" />

                        </ContentBody>
                    </ContentBox>
                }
            </div>
        }
    </PageContainer>
</LangGuard>
