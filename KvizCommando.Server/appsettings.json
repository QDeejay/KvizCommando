{
  "ConnectionStrings": {
    "SqliteApplication": "Data Source=GameUser.db",
    "SqliteGame": "Data Source=Game.db",
    "SqlServerApplication": "",
    "SqlServerGame": ""
  },

  "Database": {
    "Provider": "Sqlite",
    "EnableRetryOnFailure": false
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://kvizcommando.example.com"
    ]
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Prod"
  },

  "Email": {
    // File: helyi .eml, .html és .txt fájlok; Mail: későbbi valódi levélküldő adapter.
    "Service": "File",
    "OutputRoot": "C:\\KvizCommando\\Email",
    // Localhost | LocalNetwork | PublicTunnel
    "ActiveBaseUrl": "PublicTunnel",
    "BaseUrls": {
      "Localhost": "https://localhost:7229",
      "LocalNetwork": "https://192.168.0.220:7229",
      "PublicTunnel": "https://kviz-commando.ngrok.app"
    }
  },

  "App": {
    "Name": "Kviz Commando",
    "SupportEmail": "support@kvizcommando.com",
    "TokenValidityHours": 24
  },

  "AuditHash": {
    "Secret": ""
  },

  "PiiEncryption": {
    "Key": ""
  },

  "Audit": {
    "Provider": "File",
    "OutputRoot": "C:\\KvizCommando\\Audit",
    "RetentionDays": 30,
    "IncludeIpHash": true
  },

  "Diagnostics": {
    "EnableAuthenticationDebugLogging": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
