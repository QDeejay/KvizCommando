{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=GameUser.db",
    "GameConnection": "Data Source=Game.db"
  },

  "Database": {
    "Provider": "Sqlite",
    "EnableRetryOnFailure": false
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },

  "Jwt": {
    "Issuer": "KvizCommando",
    "Audience": "KvizCommandoClient",
    "SigningKey": "CONFIGURE_A_PRIVATE_SIGNING_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [
      "https://kvizcommando.example.com"
    ]
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Prod"
  },

  "App": {
    "Name": "Quiz Commando",
    "SupportEmail": "support@kvizcommando.com",
    "TokenValidityHours": 24,
    "TempServerIp": "192.168.0.220",
    "WebUrl": "https://kviz-commando.ngrok.app"
  },

  "AuditHash": {
    "Secret": ""
  },

  "Diagnostics": {
    "EnableAuthenticationDebugLogging": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
