{
  "ConnectionStrings": {
    "SqliteApplication": "Data Source=GameUser.db",
    "SqliteGame": "Data Source=Game.db",
    "SqlServerApplication": "",
    "SqlServerGame": ""
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "Enabled": false,
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },
  "PublicAuth": {
    "RegistrationEnabled": false,
    "InvitationTestPeriod": "16:00 - 20:00"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Prod"
  },

  "Email": {
    "SenderAddress": "DoNotReply@kvizcommando.com",
  },

  "App": {
    "Name": "Kviz Commando",
    "SupportEmail": "support@kvizcommando.com",
    "TokenValidityHours": 24
  },

  "AuditHash": {
    "Secret": ""
  },

  "PiiEncryption": {
    "Key": ""
  },

  "RegistrationBenefitHash": {
    "Secret": ""
  },

  "Audit": {
    "Provider": "File",
    "OutputRoot": "App/Audit",
    "RetentionDays": 30,
    "IncludeIpHash": true
  },

  "Diagnostics": {
    "EnableAuthenticationDebugLogging": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
