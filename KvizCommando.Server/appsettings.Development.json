{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=GameUser.db",
    "GameConnection": "Data Source=Game.db"
  },

  "Database": {
    "Provider": "Sqlite",
    "EnableRetryOnFailure": false
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },


  "Jwt": {
    "Issuer": "KvizCommando",
    "Audience": "KvizCommandoClient",
    "SigningKey": "CONFIGURE_A_PRIVATE_SIGNING_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "https://localhost:5001",
      "http://localhost:5173",
      "http://localhost:5001"
    ]
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Dev"
  },

  "AuditHash": {
    "Secret": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}

