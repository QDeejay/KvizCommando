{
  "Database": {
    "Provider": "Sqlite",
    "EnableRetryOnFailure": false
  },

  "ConnectionStrings": {
    "SqliteApplication": "Data Source=GameUser.db",
    "SqliteGame": "Data Source=Game.db",
    "SqlServerApplication": "",
    "SqlServerGame": ""
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "Enabled": false,
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },
  "PublicAuth": {
    "RegistrationEnabled": true
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "https://localhost:5001",
      "http://localhost:5173",
      "http://localhost:5001"
    ]
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Dev"
  },

  "Email": {
    // File: helyi .eml, .html és .txt fájlok; Mail: későbbi valódi levélküldő adapter.
    "Service": "Mail",
    "OutputRoot": "App/Email",
    // Localhost | LocalNetwork 
    "ActiveBaseUrl": "LocalNetwork",
    "BaseUrls": {
      "Localhost": "https://localhost:7229",
      "LocalNetwork": "https://192.168.0.220:7229"

    }
  },

  "AuditHash": {
    "Secret": "PUBLIC_TEST_ONLY_AUDIT_HMAC_SECRET_CHANGE_ME"
  },
  // Base64-kódolt 32 bájtos, kizárólag publikus tesztkulcs.
  "PiiEncryption": {
    "Key": "S0MtUFVCTElDLVRFU1QtUElJLUtFWS12MV9fX19fX18="
  },

  "RegistrationBenefitHash": {
    "Secret": "PUBLIC_TEST_ONLY_ANTICREDIT_HMAC_SECRET_CHANGE_ME"
  },

  "Audit": {
    "Provider": "File",
    "OutputRoot": "App/Audit",
    "RetentionDays": 30,
    "IncludeIpHash": true
  },

  "Diagnostics": {
    "EnableAuthenticationDebugLogging": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
