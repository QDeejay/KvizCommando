{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=GameUser.db",
    "GameConnection": "Data Source=Game.db"
  },

  "Database": {
    "Provider": "Sqlite",
    "EnableRetryOnFailure": false
  },

  "Auth": {
    "TermsPolicy": {
      "EnableDbFallback": false
    }
  },
  "Authentication": {
    "Facebook": {
      "AppId": "CONFIGURE_LOCALLY",
      "AppSecret": "CONFIGURE_LOCALLY"
    }
  },


  "Jwt": {
    "Issuer": "KvizCommando",
    "Audience": "KvizCommandoClient",
    "SigningKey": "CONFIGURE_A_PRIVATE_SIGNING_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "https://localhost:5001",
      "http://localhost:5173",
      "http://localhost:5001"
    ]
  },

  "DataProtection": {
    "KeyRingPath": "DataProtection-Keys",
    "ApplicationName": "KvizCommando-Dev"
  },

  "Email": {
    // File: helyi .eml, .html és .txt fájlok; Mail: későbbi valódi levélküldő adapter.
    "Service": "File",
    "OutputRoot": "C:\\KvizCommando\\Email",
    // Localhost | LocalNetwork | PublicTunnel
    "ActiveBaseUrl": "PublicTunnel",
    "BaseUrls": {
      "Localhost": "https://localhost:7229",
      "LocalNetwork": "https://192.168.0.220:7229",
      "PublicTunnel": "https://kviz-commando.ngrok.app"
    }
  },

  "AuditHash": {
    "Secret": ""
  },

  "Audit": {
    "Provider": "File",
    "OutputRoot": "C:\\KvizCommando\\Audit",
    "RetentionDays": 30,
    "IncludeIpHash": true
  },

  "Diagnostics": {
    "EnableAuthenticationDebugLogging": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
